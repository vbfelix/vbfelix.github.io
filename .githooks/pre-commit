#!/bin/sh
if command -v pwsh >/dev/null 2>&1; then
    shell=pwsh
elif command -v powershell.exe >/dev/null 2>&1; then
    shell=powershell.exe
else
    echo "PowerShell is required to run the site validation hook." >&2
    exit 1
fi
root=$(git rev-parse --show-toplevel) || exit 1
exec "$shell" -NoProfile -ExecutionPolicy Bypass -File "$root/scripts/site.ps1" -Action verify -Scope staged
