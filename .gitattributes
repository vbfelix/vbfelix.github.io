# Keep source files stable across Windows and Unix checkouts.
*.qmd text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.py text eol=lf
*.lua text eol=lf
*.ps1 text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
# Generated output is compared byte for byte by the agent-assets check, so a checkout must not rewrite it as CRLF.
*.html text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.js text eol=lf
*.ts text eol=lf
